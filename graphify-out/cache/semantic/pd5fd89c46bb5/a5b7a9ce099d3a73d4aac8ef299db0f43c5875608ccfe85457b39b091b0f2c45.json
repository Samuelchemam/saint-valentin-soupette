casion."}, {"id": "index_link_generation_flow", "label": "Shareable link generation & copy flow", "file_type": "rationale", "source_file": "index.html", "source_location": "lines 208-233", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "gen() builds the encoded share URL from the chosen mode's inputs and reveals it with a copy button (cp()), which copies to clipboard and shows a toast confirmation \u2014 the end-to-end mechanism by which the asker turns their message into a link to send."}], "edges": [{"source": "index_gen", "target": "index_encode", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_location": "line 223", "weight": 1.0}, {"source": "index_clp", "target": "index_mv", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_location": "line 272", "weight": 1.0}, {"source": "index_win", "target": "index_herts", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_location": "line 279", "weight": 1.0}, {"source": "index_encode", "target": "index_decode", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_location": "lines 169-227", "weight": 1.0}, {"source": "index_no_button_dodge_game", "target": "index_mv", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_location": "lines 240-266", "weight": 1.0}, {"source": "index_no_button_dodge_game", "target": "index_clp", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_location": "lines 270-273", "weight": 1.0}, {"source": "index_anti_spoiler_encoding", "target": "index_encode", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_lo